NODE_ENV=development
PORT=4000
MONGODB_USERS_URI=mongodb+srv://<db_user>:<encoded_password>@<users-cluster>/breakfast_users?retryWrites=true&w=majority
MONGODB_INGREDIENTS_URI=mongodb+srv://<db_user>:<encoded_password>@<ingredients-cluster>/breakfast_ingredients?retryWrites=true&w=majority
MONGODB_RECIPES_URI=mongodb+srv://<db_user>:<encoded_password>@<recipes-cluster>/breakfast_recipes?retryWrites=true&w=majority
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-chars
UI_ORIGIN=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo
ADMIN_NAME=Breakfast Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-seeding
USER_NAME=Breakfast User
USER_EMAIL=user@example.com
USER_PASSWORD=replace-with-a-private-password-at-least-12-characters